
$ErrorActionPreference = "Stop"

$base = "D:\Workspace\MyWorkspaceVSC\Java"
$repo = "gth_july_25_java_jdbc"
$remote = "https://github.com/ishanyadeogade/gth_july_25_java_jdbc.git"

# Find the project folder
$project = Get-ChildItem -Path $base -Directory |
    Where-Object { $_.Name -eq $repo } |
    Select-Object -First 1

if (-not $project) {
    Write-Host "ERROR: Project folder not found in $base" -ForegroundColor Red
    Write-Host "Available folders:"
    Get-ChildItem -Path $base -Directory | Select-Object -ExpandProperty Name
    throw "Check the actual folder name and update the repo variable."
}

# Move into the project folder
Set-Location $project.FullName

# Initialize Git if needed
if (-not (Test-Path ".git")) {
    git init
    if ($LASTEXITCODE -ne 0) { throw "Git initialization failed." }
}

# Stage files
git add .
if ($LASTEXITCODE -ne 0) { throw "Git add failed." }

# Commit only if there are staged changes
git diff --cached --quiet
if ($LASTEXITCODE -ne 0) {
    git commit -m "java jdbc practice"
    if ($LASTEXITCODE -ne 0) { throw "Git commit failed." }
}

# Set the branch to main
git branch -M main
if ($LASTEXITCODE -ne 0) { throw "Failed to set main branch." }

# Create the GitHub repository if it does not exist
gh repo view "ishanyadeogade/$repo" 2>$null

if ($LASTEXITCODE -ne 0) {
    gh repo create $repo --public
    if ($LASTEXITCODE -ne 0) { throw "GitHub repository creation failed." }
}

# Configure the remote
$existingRemote = git remote

if ($existingRemote -contains "origin") {
    git remote set-url origin $remote
} else {
    git remote add origin $remote
}

if ($LASTEXITCODE -ne 0) { throw "Failed to configure remote." }

# Push to GitHub
git push -u origin main

if ($LASTEXITCODE -ne 0) { throw "Git push failed." }

Write-Host "SUCCESS: Project pushed to GitHub!" -ForegroundColor Green
Write-Host "Repository: $remote"
